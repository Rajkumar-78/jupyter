   "source": [
    "# python performance test\n",
    "## list comprehension vs for loop\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "3557eccd",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "59.8 μs ± 1.28 μs per loop (mean ± std. dev. of 7 runs, 10,000 loops each)\n"
     ]
    }
   ],
   "source": [
    "numbers = list(range(1000))\n",
    "\n",
    "def double_numbers(numbers):\n",
    "    result = []\n",
    "    for x in numbers:\n",
    "        result.append(x * 2)\n",
    "    return result\n",
    "\n",
    "%timeit double_numbers(numbers)"
   ]
  }
 ],
